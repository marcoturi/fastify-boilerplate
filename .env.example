NODE_ENV=development
POSTGRES_PASSWORD=test
POSTGRES_USER=admin
POSTGRES_DB=test
POSTGRES_URL=127.0.0.1:5432
# dbmate expands the variables above
DBMATE_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_URL}/${POSTGRES_DB}?sslmode=disable

# Optional, with their defaults and meaning in src/config/env.ts: LOG_LEVEL, PORT, HOST,
# POSTGRES_SSL, POSTGRES_POOL_MAX, POSTGRES_IDLE_TIMEOUT, POSTGRES_CONNECT_TIMEOUT.
# Leave HOST unset: `docker run --env-file .env` would otherwise replace the image's 0.0.0.0
# and make the container unreachable

# OpenTelemetry — disabled by default; enable when a collector is available.
# See https://opentelemetry.io/docs/languages/sdk-configuration/general/
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=fastify-boilerplate
