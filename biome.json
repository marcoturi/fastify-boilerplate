{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!doc"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100,
    "bracketSpacing": true,
    "includes": [
      "**",
      "!**/.vscode",
      "!**/.idea",
      "!**/.DS_Store",
      "!**/*.md",
      "!**/pnpm-lock.yaml",
      "!client/package.json"
    ]
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noAdjacentSpacesInRegex": "error",
        "noBannedTypes": "error",
        "noExcessiveCognitiveComplexity": "error",
        "noExtraBooleanCast": "error",
        "noForEach": "error",
        "noStaticOnlyClass": "error",
        "noUselessCatch": "error",
        "noUselessConstructor": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessSwitchCase": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "useDateNow": "error",
        "useFlatMap": "error",
        "useIndexOf": "error",
        "useWhile": "error"
      },
      "correctness": {
        "noGlobalDirnameFilename": "error",
        "noUndeclaredVariables": "error",
        "noUnusedImports": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error",
        "useImportExtensions": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noInferrableTypes": "error",
        "noEnum": "error",
        "noNamespace": "error",
        "noNegationElse": "off",
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../**"],
                "message": "Import from a parent folder through the #src/ or #tests/ alias"
              }
            ]
          }
        },
        "noSubstr": "error",
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error",
        "useAtIndex": "error",
        "useCollapsedIf": "error",
        "useConsistentArrayType": "error",
        "useConsistentTypeDefinitions": "error",
        "useExplicitLengthCheck": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case"] }
        },
        "useForOf": "error",
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useNumericSeparators": "error",
        "useShorthandFunctionType": "error",
        "useThrowNewError": "error",
        "useTrimStartEnd": "error",
        "useUnifiedTypeSignatures": "error"
      },
      "suspicious": {
        "noCatchAssign": "error",
        "noConfusingVoidType": "error",
        "noConsole": "error",
        "noConstantBinaryExpressions": "error",
        "noDocumentCookie": "error",
        "noEmptyBlockStatements": "error",
        "noExplicitAny": "error",
        "noExtraNonNullAssertion": "error",
        "noImportCycles": "error",
        "noIrregularWhitespace": "error",
        "noPrototypeBuiltins": "error",
        "noTsIgnore": "error",
        "noUselessRegexBackrefs": "error",
        "useAdjacentOverloadSignatures": "error",
        "useErrorMessage": "error",
        "useNumberToFixedDigitsArgument": "error"
      },
      "security": {
        "noSecrets": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  },
  "overrides": [
    {
      "includes": ["**/*.spec.ts", "**/tests/**/*.ts"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "suspicious": { "noExplicitAny": "off" },
          "security": { "noSecrets": "off" }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  }
}
